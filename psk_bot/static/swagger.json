{
  "openapi": "3.0.3",
  "info": {
    "title": "PSK Bot API",
    "description": "API documentation for PSK Bot — a fast AI assistant powered by Ollama (gemma3:1b).\n\nPSK Bot supports **document-based RAG** (Retrieval-Augmented Generation) and **direct LLM conversation** for general knowledge queries.\n\nAll responses stream directly from the Ollama serving endpoint via SSE for minimal latency.\n\n## Document Ingestion\nDocuments are parsed with **OCR support** — scanned PDFs, embedded images, charts, and diagrams are all extracted and indexed. Supported file types: `.pdf`, `.docx`, `.txt`, `.md`, `.png`, `.jpg`, `.jpeg`, `.tiff`, `.tif`, `.bmp`, `.webp`.\n\n## Document-Mode Behavior\nWhen a `document_id` is provided, the bot answers **strictly from the document**. It will never fall back to general knowledge — if the answer isn't in the document, it says so.\n\n## Authentication\nRobot API endpoints (`/api/v1/*`) support optional API key authentication.\n- Set `PSK_API_KEY` in the server `.env` file to enable it.\n- Pass the key via `X-API-Key` header or `api_key` query parameter.\n- If no key is configured on the server, all endpoints are open.\n\nAdmin endpoints (`/admin/api/*`) require session-based authentication via `/admin/login`.\n\n## Rate Limiting\nRobot endpoints are rate-limited to **30 requests/minute** per client (configurable via `API_RATE_LIMIT`).\nClients are identified by `X-Client-ID` header or IP address.\n\n## Streaming (SSE)\nEndpoints returning `text/event-stream` use **Server-Sent Events**.\nEach event is a JSON object prefixed with `data: ` and terminated by `\\n\\n`.",
    "version": "2.1.0",
    "contact": {
      "name": "PlanetSkool",
      "url": "https://planetskool.com"
    }
  },
  "servers": [
    {
      "url": "https://chatbot.planetskool.com",
      "description": "Production"
    },
    {
      "url": "http://localhost:5173",
      "description": "Local development"
    }
  ],
  "tags": [
    {
      "name": "Robot API",
      "description": "Low-latency endpoints designed for robot hardware integration. Streams directly from Ollama."
    },
    {
      "name": "Web UI API",
      "description": "Endpoints used by the PSK Bot web chat interface. Streams directly from Ollama via SSE."
    },
    {
      "name": "Admin API",
      "description": "Document management endpoints. Requires admin session (login via `/admin/login`)."
    },
    {
      "name": "Health",
      "description": "Service health checks and monitoring."
    }
  ],
  "paths": {
    "/api/v1/chat": {
      "post": {
        "tags": ["Robot API"],
        "summary": "Chat (full response)",
        "description": "Send a message and receive a **complete response** in a single JSON reply.\n\nThis is the primary endpoint for robot hardware — optimized for low latency.\n\n**How it works:**\n1. If `document_id` is provided, answers **strictly** from that document (no general knowledge fallback)\n2. If no relevant content is found in the document, the bot says so\n3. If no `document_id`, queries the LLM directly with general knowledge\n4. Simple greetings (\"hi\", \"hello\") get instant responses without LLM",
        "operationId": "robotChat",
        "security": [{"ApiKeyHeader": []}, {}],
        "parameters": [
          {
            "name": "X-Client-ID",
            "in": "header",
            "description": "Client identifier for rate limiting (defaults to IP address)",
            "schema": {"type": "string", "example": "robot_01"}
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/ChatRequest"},
              "examples": {
                "simple_question": {
                  "summary": "General question (direct LLM)",
                  "value": {
                    "message": "What is the capital of France?",
                    "session_id": "robot_01"
                  }
                },
                "document_question": {
                  "summary": "Question about a specific document",
                  "value": {
                    "message": "What is the leave policy?",
                    "document_id": "gentari_employee_handbook_e84d2400",
                    "session_id": "robot_01"
                  }
                },
                "greeting": {
                  "summary": "Greeting (instant response, no LLM)",
                  "value": {
                    "message": "Hello!",
                    "session_id": "robot_01"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ChatResponse"},
                "examples": {
                  "document_answer": {
                    "summary": "Answer from document (RAG)",
                    "value": {
                      "response": "The annual leave policy allows employees to take up to 20 days of paid leave per year.",
                      "latency_ms": 2340,
                      "source": "document",
                      "session_id": "robot_01"
                    }
                  },
                  "llm_answer": {
                    "summary": "Answer from direct LLM",
                    "value": {
                      "response": "The capital of France is Paris.",
                      "latency_ms": 1800,
                      "source": "llm",
                      "session_id": "robot_01"
                    }
                  },
                  "greeting_answer": {
                    "summary": "Greeting (instant)",
                    "value": {
                      "response": "Hello! I'm PSK Bot. How can I assist you today?",
                      "latency_ms": 1,
                      "source": "greeting",
                      "session_id": "robot_01"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request — missing message or document not ready",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ErrorResponse"},
                "example": {"error": "Message is required."}
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {
            "description": "Document not found",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ErrorResponse"},
                "example": {"error": "Document not found."}
              }
            }
          },
          "429": {"$ref": "#/components/responses/RateLimited"},
          "503": {"$ref": "#/components/responses/ServiceUnavailable"}
        }
      }
    },
    "/api/v1/chat/stream": {
      "post": {
        "tags": ["Robot API"],
        "summary": "Chat (SSE streaming)",
        "description": "Send a message and receive the response as a **stream of tokens** via Server-Sent Events (SSE).\n\nTokens stream directly from Ollama for minimal latency.\n\n**SSE Event Format:**\n```\ndata: {\"token\": \"Hello\", \"type\": \"token\"}\ndata: {\"token\": \" there\", \"type\": \"token\"}\ndata: {\"type\": \"done\", \"latency_ms\": 2340, \"source\": \"document\", \"session_id\": \"robot_01\"}\n```\n\n**Event types:**\n- `token` — A chunk of the response text\n- `done` — Stream complete, includes metadata\n- `error` — An error occurred during generation",
        "operationId": "robotChatStream",
        "security": [{"ApiKeyHeader": []}, {}],
        "parameters": [
          {
            "name": "X-Client-ID",
            "in": "header",
            "description": "Client identifier for rate limiting",
            "schema": {"type": "string", "example": "robot_01"}
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/ChatRequest"},
              "examples": {
                "stream_question": {
                  "summary": "Stream a document question",
                  "value": {
                    "message": "Summarize the corporate profile",
                    "document_id": "fm_48736d23",
                    "session_id": "robot_01"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSE stream of tokens",
            "content": {
              "text/event-stream": {
                "schema": {"type": "string"},
                "example": "data: {\"token\": \"The \", \"type\": \"token\"}\n\ndata: {\"token\": \"company \", \"type\": \"token\"}\n\ndata: {\"type\": \"done\", \"latency_ms\": 2340, \"source\": \"document\", \"session_id\": \"robot_01\"}\n\n"
              }
            }
          },
          "400": {"description": "Bad request", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "429": {"$ref": "#/components/responses/RateLimited"},
          "503": {"$ref": "#/components/responses/ServiceUnavailable"}
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check (robot)",
        "description": "Lightweight health check for monitoring from robot hardware or load balancers.",
        "operationId": "robotHealth",
        "security": [{"ApiKeyHeader": []}, {}],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/HealthResponse"},
                "example": {"status": "ok", "model": "gemma3:1b", "timestamp": 1739500000.0}
              }
            }
          },
          "503": {
            "description": "Service is degraded",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/HealthResponse"},
                "example": {"status": "degraded", "model": "gemma3:1b", "timestamp": 1739500000.0}
              }
            }
          }
        }
      }
    },
    "/api/v1/documents": {
      "get": {
        "tags": ["Robot API"],
        "summary": "List available documents",
        "description": "Returns all uploaded documents and their processing status.\n\nUse this to discover valid `document_id` values for the chat endpoints.\n\n**Document statuses:**\n- `ready` — Indexed and queryable\n- `processing` — Being ingested (with OCR if needed)\n- `failed` — Failed to process\n\n**Supported file types:** `.pdf`, `.docx`, `.txt`, `.md`, `.png`, `.jpg`, `.jpeg`, `.tiff`, `.tif`, `.bmp`, `.webp`\n\nPDF and image files are processed with OCR to extract text from scanned pages, charts, and diagrams.",
        "operationId": "robotListDocuments",
        "security": [{"ApiKeyHeader": []}, {}],
        "responses": {
          "200": {
            "description": "List of documents",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/DocumentListResponse"},
                "example": {
                  "documents": [
                    {"id": "fm_48736d23", "name": "Corporate Profile.pdf", "status": "ready"},
                    {"id": "handbook_e84d2400", "name": "Employee Handbook.pdf", "status": "ready"}
                  ]
                }
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      }
    },
    "/admin/api/documents": {
      "get": {
        "tags": ["Admin API"],
        "summary": "List all documents",
        "description": "Returns all documents with full metadata including processing status, chunk count, and error details.",
        "operationId": "adminListDocuments",
        "responses": {
          "200": {
            "description": "Document list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "documents": {"type": "array", "items": {"$ref": "#/components/schemas/DocumentDetail"}},
                    "count": {"type": "integer"}
                  }
                },
                "example": {
                  "documents": [
                    {
                      "id": "fm_48736d23",
                      "name": "Corporate Profile.pdf",
                      "filename": "Corporate Profile.pdf",
                      "file_type": "pdf",
                      "file_size": 2048576,
                      "status": "ready",
                      "chunk_count": 42,
                      "error_message": null,
                      "created_at": "2026-02-15T18:48:34Z"
                    }
                  ],
                  "count": 1
                }
              }
            }
          },
          "401": {"description": "Not authenticated"}
        }
      },
      "post": {
        "tags": ["Admin API"],
        "summary": "Upload a document",
        "description": "Upload a document for ingestion. The file is parsed (with OCR for PDFs/images), chunked, and indexed into the vector store in a background thread.\n\n**Supported file types:** `.pdf`, `.docx`, `.txt`, `.md`, `.png`, `.jpg`, `.jpeg`, `.tiff`, `.tif`, `.bmp`, `.webp`\n\n**Max file size:** 50 MB\n\n**OCR capabilities:**\n- Scanned PDF pages are rendered as images and OCR'd\n- Embedded images in PDFs and DOCX files are extracted and OCR'd\n- Standalone image files are fully OCR'd\n- Images are preprocessed (upscaled, contrast-enhanced, sharpened) for best accuracy",
        "operationId": "adminUploadDocument",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": {"type": "string", "format": "binary", "description": "The document file to upload"},
                  "name": {"type": "string", "description": "Optional display name (defaults to filename)"}
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Document uploaded, ingestion started",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {"type": "boolean"},
                    "document": {"$ref": "#/components/schemas/DocumentDetail"},
                    "message": {"type": "string"}
                  }
                },
                "example": {
                  "success": true,
                  "document": {
                    "id": "fm_48736d23",
                    "name": "Corporate Profile.pdf",
                    "filename": "Corporate Profile.pdf",
                    "file_type": "pdf",
                    "file_size": 2048576,
                    "status": "processing",
                    "chunk_count": 0,
                    "error_message": null,
                    "created_at": "2026-02-15T18:48:34Z"
                  },
                  "message": "Document uploaded. Ingestion started."
                }
              }
            }
          },
          "400": {
            "description": "Invalid file or unsupported type",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ErrorResponse"},
                "examples": {
                  "no_file": {"value": {"error": "No file provided"}},
                  "bad_type": {"value": {"error": "Unsupported file type: .exe. Supported: .pdf, .docx, .txt, .md, .png, .jpg, .jpeg, .tiff, .tif, .bmp, .webp"}}
                }
              }
            }
          },
          "401": {"description": "Not authenticated"}
        }
      }
    },
    "/admin/api/documents/{doc_id}": {
      "get": {
        "tags": ["Admin API"],
        "summary": "Get document details",
        "description": "Returns full details for a single document.",
        "operationId": "adminGetDocument",
        "parameters": [{"name": "doc_id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {
            "description": "Document details",
            "content": {"application/json": {"schema": {"type": "object", "properties": {"document": {"$ref": "#/components/schemas/DocumentDetail"}}}}}
          },
          "404": {"description": "Document not found", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "401": {"description": "Not authenticated"}
        }
      },
      "delete": {
        "tags": ["Admin API"],
        "summary": "Delete a document",
        "description": "Deletes a document and its vector store. Cannot delete while processing.",
        "operationId": "adminDeleteDocument",
        "parameters": [{"name": "doc_id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {
            "description": "Document deleted",
            "content": {"application/json": {"schema": {"type": "object", "properties": {"success": {"type": "boolean"}, "message": {"type": "string"}}}, "example": {"success": true, "message": "Document deleted"}}}
          },
          "404": {"description": "Document not found", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "409": {"description": "Document is being processed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}, "example": {"error": "Cannot delete document while processing"}}}},
          "401": {"description": "Not authenticated"}
        }
      }
    },
    "/admin/api/documents/{doc_id}/status": {
      "get": {
        "tags": ["Admin API"],
        "summary": "Get ingestion status",
        "description": "Returns the current ingestion status of a document, including whether background processing is active.",
        "operationId": "adminDocumentStatus",
        "parameters": [{"name": "doc_id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {
            "description": "Ingestion status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {"type": "string"},
                    "status": {"type": "string", "enum": ["uploading", "processing", "ready", "failed"]},
                    "is_processing": {"type": "boolean", "description": "Whether the background ingestion thread is still running"},
                    "chunk_count": {"type": "integer"},
                    "error_message": {"type": "string", "nullable": true}
                  }
                },
                "example": {"id": "fm_48736d23", "status": "ready", "is_processing": false, "chunk_count": 42, "error_message": null}
              }
            }
          },
          "404": {"description": "Document not found", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "401": {"description": "Not authenticated"}
        }
      }
    },
    "/admin/api/documents/public": {
      "get": {
        "tags": ["Web UI API"],
        "summary": "List chat-ready documents",
        "description": "Returns documents with `ready` status for the chat document selector. **No authentication required.**",
        "operationId": "publicListDocuments",
        "responses": {
          "200": {
            "description": "Ready documents",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "documents": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {"type": "string"},
                          "name": {"type": "string"},
                          "chunk_count": {"type": "integer"}
                        }
                      }
                    }
                  }
                },
                "example": {
                  "documents": [
                    {"id": "fm_48736d23", "name": "Corporate Profile.pdf", "chunk_count": 42}
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "tags": ["Web UI API"],
        "summary": "Chat (full response)",
        "description": "Send a question and get a complete response. Uses the default vector store for RAG, or falls back to direct LLM.\n\nFor robot integration, prefer `/api/v1/chat`.",
        "operationId": "webChat",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["question"],
                "properties": {
                  "question": {"type": "string", "description": "The user's question", "example": "What is the leave policy?"},
                  "history": {
                    "type": "array",
                    "description": "Conversation history",
                    "items": {"type": "object", "properties": {"user": {"type": "string"}, "bot": {"type": "string"}}},
                    "default": []
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {"type": "object", "properties": {"response": {"type": "string"}, "latency_ms": {"type": "integer"}}},
                "example": {"response": "The leave policy allows...", "latency_ms": 2340}
              }
            }
          },
          "400": {"description": "Missing question", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "503": {"$ref": "#/components/responses/ServiceUnavailable"}
        }
      }
    },
    "/api/stream": {
      "post": {
        "tags": ["Web UI API"],
        "summary": "Chat (SSE streaming)",
        "description": "Send a question and receive tokens via SSE, streamed directly from Ollama.\n\n**SSE format:** `data: <token_text>\\n\\n`. Final event: `data: [DONE]\\n\\n`.",
        "operationId": "webStream",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["question"],
                "properties": {
                  "question": {"type": "string", "example": "What is the leave policy?"},
                  "history": {"type": "array", "items": {"type": "object", "properties": {"user": {"type": "string"}, "bot": {"type": "string"}}}, "default": []}
                }
              }
            }
          }
        },
        "responses": {
          "200": {"description": "SSE stream", "content": {"text/event-stream": {"schema": {"type": "string"}, "example": "data: The \n\ndata: leave \n\ndata: policy...\n\ndata: [DONE]\n\n"}}},
          "400": {"description": "Missing question", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "503": {"$ref": "#/components/responses/ServiceUnavailable"}
        }
      }
    },
    "/api/stream_prepared": {
      "post": {
        "tags": ["Web UI API"],
        "summary": "Stream from pre-built messages",
        "description": "Stream a response from Ollama using pre-built messages from `/api/prepare` or `/api/prepare_free`.\n\n**Flow:** Frontend → `/api/prepare` → gets messages → `/api/stream_prepared` → SSE tokens from Ollama",
        "operationId": "webStreamPrepared",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["messages"],
                "properties": {
                  "messages": {"type": "array", "description": "Message array from prepare endpoint's `history_messages`", "items": {"type": "object", "properties": {"role": {"type": "string", "enum": ["system", "user", "assistant"]}, "content": {"type": "string"}}}},
                  "model": {"type": "string", "description": "Ollama model (defaults to configured model)", "example": "gemma3:1b"},
                  "options": {"type": "object", "description": "Ollama generation options override", "additionalProperties": true}
                }
              }
            }
          }
        },
        "responses": {
          "200": {"description": "SSE stream of tokens", "content": {"text/event-stream": {"schema": {"type": "string"}, "example": "data: {\"token\": \"Hello\", \"type\": \"token\"}\n\ndata: {\"type\": \"done\"}\n\n"}}},
          "400": {"description": "Missing messages", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "503": {"$ref": "#/components/responses/ServiceUnavailable"}
        }
      }
    },
    "/api/prepare": {
      "post": {
        "tags": ["Web UI API"],
        "summary": "Prepare RAG prompt (document mode)",
        "description": "Builds a RAG-augmented prompt for a specific document. Answers **strictly from the document** — no general knowledge fallback.\n\n**Flow:** Frontend → `/api/prepare` → gets prompt + messages → `/api/stream_prepared` → SSE stream from Ollama",
        "operationId": "webPrepare",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["question", "document_id"],
                "properties": {
                  "question": {"type": "string", "example": "What is the leave policy?"},
                  "document_id": {"type": "string", "description": "ID of the document to query", "example": "fm_48736d23"},
                  "history": {"type": "array", "description": "Chat history for context", "items": {"type": "object", "properties": {"role": {"type": "string", "enum": ["user", "assistant"]}, "content": {"type": "string"}}}, "default": []}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Prepared prompt and options",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/PrepareResponse"},
                "examples": {
                  "with_context": {
                    "summary": "Document context found",
                    "value": {
                      "prompt": "You are a professional assistant...\n\nCONTEXT: ...\n\nQUESTION: What is the leave policy?",
                      "has_context": true,
                      "model": "gemma3:1b",
                      "options": {"temperature": 0.2, "top_p": 0.8, "num_ctx": 2048, "num_predict": 384},
                      "history_messages": [{"role": "system", "content": "You are PSK Bot..."}, {"role": "user", "content": "What is the leave policy?"}],
                      "document_id": "fm_48736d23"
                    }
                  },
                  "greeting": {
                    "summary": "Greeting detected (no LLM needed)",
                    "value": {"is_greeting": true, "response": "Hello! I'm PSK Bot. How can I assist you today?", "model": "gemma3:1b"}
                  }
                }
              }
            }
          },
          "400": {"description": "Missing question or document_id, or document not ready", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "404": {"description": "Document not found", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}, "example": {"error": "Document not found."}}}},
          "503": {"$ref": "#/components/responses/ServiceUnavailable"}
        }
      }
    },
    "/api/prepare_free": {
      "post": {
        "tags": ["Web UI API"],
        "summary": "Prepare prompt (free chat mode)",
        "description": "Builds a prompt for free-form chat without requiring a document. Queries the LLM directly with general knowledge.\n\n**Flow:** Frontend → `/api/prepare_free` → gets messages → `/api/stream_prepared` → SSE stream from Ollama",
        "operationId": "webPrepareFree",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["question"],
                "properties": {
                  "question": {"type": "string", "example": "Tell me about quantum computing"},
                  "history": {"type": "array", "items": {"type": "object", "properties": {"role": {"type": "string", "enum": ["user", "assistant"]}, "content": {"type": "string"}}}, "default": []}
                }
              }
            }
          }
        },
        "responses": {
          "200": {"description": "Prepared prompt", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PrepareResponse"}}}},
          "400": {"description": "Missing question", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
          "503": {"$ref": "#/components/responses/ServiceUnavailable"}
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": ["Health"],
        "summary": "Detailed health check",
        "description": "Returns detailed service health including RAG readiness, vector store status, and OCR availability.\n\nUsed by Nginx health checks and monitoring dashboards.",
        "operationId": "healthCheck",
        "responses": {
          "200": {
            "description": "All services healthy",
            "content": {
              "application/json": {
                "schema": {"type": "object", "properties": {"status": {"type": "string", "enum": ["ok", "degraded"]}, "rag_ready": {"type": "boolean"}, "vector_store_ready": {"type": "boolean"}, "model": {"type": "string", "nullable": true}}},
                "example": {"status": "ok", "rag_ready": true, "vector_store_ready": true, "model": "gemma3:1b"}
              }
            }
          },
          "503": {
            "description": "Service degraded",
            "content": {
              "application/json": {
                "example": {"status": "degraded", "rag_ready": false, "vector_store_ready": false, "model": null}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key for robot endpoints. Set `PSK_API_KEY` in `.env` to enable. If not set, endpoints are open."
      },
      "ApiKeyQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "api_key",
        "description": "Alternative: pass API key as query parameter"
      }
    },
    "schemas": {
      "ChatRequest": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": {"type": "string", "description": "The user's message or question.", "example": "What is the leave policy?"},
          "document_id": {"type": "string", "description": "Optional. ID of a specific document to query. When provided, the bot answers **strictly** from that document — no general knowledge fallback.\n\nGet valid IDs from `GET /api/v1/documents`.", "example": "fm_48736d23", "nullable": true},
          "session_id": {"type": "string", "description": "Optional. Client session identifier. Defaults to client IP.", "example": "robot_01"},
          "history": {
            "type": "array",
            "description": "Optional. Previous conversation turns for follow-up context.",
            "items": {"type": "object", "properties": {"role": {"type": "string", "enum": ["user", "assistant"]}, "content": {"type": "string"}}, "required": ["role", "content"]},
            "example": [{"role": "user", "content": "What is the leave policy?"}, {"role": "assistant", "content": "The leave policy includes..."}]
          }
        }
      },
      "ChatResponse": {
        "type": "object",
        "properties": {
          "response": {"type": "string", "description": "The complete bot response text"},
          "latency_ms": {"type": "integer", "description": "Total processing time in milliseconds"},
          "source": {"type": "string", "enum": ["document", "llm", "greeting"], "description": "Where the answer came from:\n- `document` — From uploaded document via RAG (strict, no outside knowledge)\n- `llm` — Direct LLM response (general knowledge)\n- `greeting` — Instant greeting response (no LLM used)"},
          "session_id": {"type": "string", "description": "Echo of the session_id from the request"}
        }
      },
      "StreamEvent": {
        "type": "object",
        "description": "A single SSE event in the stream",
        "properties": {
          "token": {"type": "string", "description": "A chunk of response text (present when type=token)"},
          "type": {"type": "string", "enum": ["token", "done", "error"], "description": "Event type"},
          "latency_ms": {"type": "integer", "description": "Total time in ms (present when type=done)"},
          "source": {"type": "string", "enum": ["document", "llm", "greeting"], "description": "Answer source (present when type=done)"},
          "session_id": {"type": "string", "description": "Session ID (present when type=done)"}
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {"type": "string", "enum": ["ok", "degraded"]},
          "model": {"type": "string", "nullable": true, "description": "Currently loaded LLM model"},
          "timestamp": {"type": "number", "format": "double", "description": "Unix timestamp"}
        }
      },
      "DocumentListResponse": {
        "type": "object",
        "properties": {
          "documents": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {"type": "string", "description": "Document ID — use this in chat requests"},
                "name": {"type": "string", "description": "Display name"},
                "status": {"type": "string", "enum": ["ready", "processing", "failed"]}
              }
            }
          }
        }
      },
      "DocumentDetail": {
        "type": "object",
        "description": "Full document metadata returned by admin endpoints",
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string", "description": "Display name"},
          "filename": {"type": "string", "description": "Original uploaded filename"},
          "file_type": {"type": "string", "description": "File extension without dot", "enum": ["pdf", "docx", "txt", "md", "png", "jpg", "jpeg", "tiff", "tif", "bmp", "webp"]},
          "file_size": {"type": "integer", "description": "File size in bytes"},
          "status": {"type": "string", "enum": ["uploading", "processing", "ready", "failed"]},
          "chunk_count": {"type": "integer", "description": "Number of text chunks after ingestion"},
          "error_message": {"type": "string", "nullable": true, "description": "Error details if status is failed"},
          "created_at": {"type": "string", "format": "date-time"}
        }
      },
      "PrepareResponse": {
        "type": "object",
        "description": "Response from prepare endpoints — contains the assembled prompt and Ollama options for streaming via /api/stream_prepared",
        "properties": {
          "prompt": {"type": "string", "description": "The fully assembled prompt (with RAG context if applicable)"},
          "has_context": {"type": "boolean", "description": "Whether document context was found and included"},
          "model": {"type": "string", "description": "Ollama model to use"},
          "options": {"type": "object", "description": "Ollama generation options (temperature, top_p, etc.)", "additionalProperties": true},
          "history_messages": {"type": "array", "description": "Complete message array for Ollama. Pass directly to /api/stream_prepared.", "items": {"type": "object", "properties": {"role": {"type": "string", "enum": ["system", "user", "assistant"]}, "content": {"type": "string"}}}},
          "document_id": {"type": "string", "description": "Echo of the document_id (only in /api/prepare)", "nullable": true},
          "is_greeting": {"type": "boolean", "description": "If true, `response` contains a direct greeting — no LLM call needed"},
          "response": {"type": "string", "description": "Direct response (only present for greetings)"}
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {"type": "string", "description": "Human-readable error message"}
        },
        "required": ["error"]
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Invalid or missing API key",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}, "example": {"error": "Invalid or missing API key."}}}
      },
      "RateLimited": {
        "description": "Rate limit exceeded (30 req/min per client)",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}, "example": {"error": "Rate limit exceeded. Please wait."}}}
      },
      "ServiceUnavailable": {
        "description": "Service unavailable — Ollama not ready",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}, "example": {"error": "Service unavailable."}}}
      }
    }
  }
}
