# Environment variables for 2-core, 8GB RAM optimization
# Copy this to .env for automatic loading

# Core application settings
DEBUG=false
PORT=5173

# Model settings optimized for low-resource VM
OLLAMA_MODEL=gemma3:1b
OLLAMA_BASE_URL=http://localhost:11434

# Embedding model (lightweight but effective)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# RAG settings optimized for better answer quality on 2-core VM
CHUNK_SIZE=384
CHUNK_OVERLAP=64
TOP_K_RESULTS=2
MAX_CONVERSATION_HISTORY=4

# Vector store settings
VECTOR_STORE_INDEX_NAME=faiss_index

# Memory and threading optimizations
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
NUMEXPR_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
TOKENIZERS_PARALLELISM=false

# Python optimizations
PYTHONOPTIMIZE=1
PYTHONDONTWRITEBYTECODE=1
