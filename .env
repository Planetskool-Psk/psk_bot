# Environment variables for professional RAG chatbot
# Optimized for quality responses with good performance

# Core application settings
DEBUG=false
PORT=5173

# Model settings - gemma3:1b is fast and capable
OLLAMA_MODEL=gemma3:1b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=5m

# Embedding model (using Ollama for Mac compatibility)
EMBEDDING_MODEL_NAME=nomic-embed-text

# RAG settings - optimized for better context retrieval
CHUNK_SIZE=512
CHUNK_OVERLAP=100
TOP_K_RESULTS=4
CONTEXT_DOCUMENTS=4
CONTEXT_CHAR_LIMIT=3500
MAX_CONVERSATION_HISTORY=5

# LLM Generation - balanced for quality + speed
LLM_NUM_PREDICT=512
LLM_NUM_CTX=4096
LLM_NUM_THREAD=4
LLM_NUM_BATCH=512
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
LLM_TOP_K=40
LLM_TIMEOUT=180

# Vector store settings
VECTOR_STORE_INDEX_NAME=faiss_index

# Memory and threading optimizations
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
NUMEXPR_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
VECLIB_MAXIMUM_THREADS=2
TOKENIZERS_PARALLELISM=false

# Prevent multiprocessing issues on Mac
KMP_DUPLICATE_LIB_OK=TRUE
OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES

# Disable PyTorch internal threading to prevent OpenMP conflicts
PYTORCH_ENABLE_MPS_FALLBACK=1
OMP_WAIT_POLICY=PASSIVE
KMP_BLOCKTIME=0

# Python optimizations
PYTHONOPTIMIZE=1
PYTHONDONTWRITEBYTECODE=1
