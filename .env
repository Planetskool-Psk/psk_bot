# ═══ PSK Bot Configuration ═══
# Optimized for 2-core / 12GB RAM / AMD Milan VM

# Core application settings
DEBUG=false
PORT=5173
OPTIMIZED_MODE=true

# Model settings - gemma3:1b for fast, friendly responses
OLLAMA_MODEL=gemma3:1b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=30m

# Embedding model
EMBEDDING_MODEL_NAME=nomic-embed-text

# RAG settings - tuned for speed
CHUNK_SIZE=512
CHUNK_OVERLAP=100
TOP_K_RESULTS=5
CONTEXT_DOCUMENTS=5
CONTEXT_CHAR_LIMIT=3000
MAX_CONVERSATION_HISTORY=6
PROMPT_HISTORY_TURNS=3

# LLM Generation — tuned for 2-core CPU speed
LLM_NUM_PREDICT=384
LLM_NUM_CTX=2048
LLM_NUM_THREAD=2
LLM_NUM_BATCH=256
LLM_TEMPERATURE=0.4
LLM_TOP_P=0.85
LLM_TOP_K=30
LLM_TIMEOUT=120

# Web search settings
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=3
WEB_SEARCH_TIMEOUT=8

# Robot API security (set a strong key for production!)
PSK_API_KEY=
API_RATE_LIMIT=30

# Vector store settings
VECTOR_STORE_INDEX_NAME=faiss_index

# Memory and threading optimizations
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
NUMEXPR_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
VECLIB_MAXIMUM_THREADS=2
TOKENIZERS_PARALLELISM=false

# Prevent multiprocessing issues on Mac
KMP_DUPLICATE_LIB_OK=TRUE
OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES

# Disable PyTorch internal threading to prevent OpenMP conflicts
PYTORCH_ENABLE_MPS_FALLBACK=1
OMP_WAIT_POLICY=PASSIVE
KMP_BLOCKTIME=0

# Python optimizations
PYTHONOPTIMIZE=1
PYTHONDONTWRITEBYTECODE=1
